{
  "name": "dsh-inbox-bridge",
  "version": "2.18.0",
  "displayName": "GitHub inbox",
  "description": "DSH 插件：让 agent 像维护者一样盯着你的仓库——按会话订阅仓库，取回与你有关、需要你处理的事件（失败的 CI、待评审的 PR、指派给你的 issue、@你的评论、开着的安全告警），在自己的回合送进上下文；会话空闲又遇到要紧的事时也能主动开一轮，让 agent 自己去修、去审、去接。",
  "type": "module",
  "license": "MIT",
  "author": "c3115644151",
  "homepage": "https://github.com/c3115644151/dsh-inbox-bridge#readme",
  "bugs": {
    "url": "https://github.com/c3115644151/dsh-inbox-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3115644151/dsh-inbox-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "inbox",
    "ci"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "icon.svg",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test index.test.mjs scripts/github-inbox.test.mjs scripts/inbox-bridge.test.mjs",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "market:release": "node scripts/build-market-index.mjs --check --release"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
