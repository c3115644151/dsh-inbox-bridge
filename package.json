{
  "name": "dsh-inbox-bridge",
  "version": "3.2.0",
  "displayName": "GitHub inbox",
  "description": "DSH 插件：让每个会话自己盯 GitHub——它提的 PR 被评审、CI 挂了、派给它的 issue 有人回，下一轮自动进上下文，空闲时还能自己开一轮。只读，不改仓库。",
  "type": "module",
  "license": "MIT",
  "author": "c3115644151",
  "homepage": "https://github.com/c3115644151/dsh-inbox-bridge#readme",
  "bugs": {
    "url": "https://github.com/c3115644151/dsh-inbox-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3115644151/dsh-inbox-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "inbox",
    "ci"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/github-inbox.mjs",
    "scripts/inbox-bridge.mjs",
    "scripts/key.mjs",
    "scripts/state-root.mjs",
    "docs/how-it-works.md",
    "docs/configuration.md",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test index.test.mjs scripts/github-inbox.test.mjs scripts/inbox-bridge.test.mjs scripts/packaging.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify": "npm test && npm run docs:check && npm run verify:install",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "market:release": "node scripts/build-market-index.mjs --check --release",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
