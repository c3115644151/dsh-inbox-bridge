{
  "name": "dsh-inbox-bridge",
  "version": "2.21.1",
  "displayName": "GitHub inbox",
  "description": "DSH 插件：给每个会话配一个自己的 GitHub 通知器——用这个会话的身份看它做的事有没有回音（我提的 PR 被评审了吗、CI 挂在哪一次、派给我的 issue 有人回了没有），连同接管的仓库里的 CI 失败、安全告警、评审请求与 @提及，在自己回合送进上下文；会话空闲又遇到要紧的事时也能主动开一轮。仓库级的事只给接管者，条目级的事给在仓库里干活的会话，同一条事实只叫一个会话。只读 GitHub。",
  "type": "module",
  "license": "MIT",
  "author": "c3115644151",
  "homepage": "https://github.com/c3115644151/dsh-inbox-bridge#readme",
  "bugs": {
    "url": "https://github.com/c3115644151/dsh-inbox-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3115644151/dsh-inbox-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "inbox",
    "ci"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "icon.svg",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test index.test.mjs scripts/github-inbox.test.mjs scripts/inbox-bridge.test.mjs scripts/clear-inbox.test.mjs",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "market:release": "node scripts/build-market-index.mjs --check --release"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
