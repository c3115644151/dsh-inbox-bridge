{
  "name": "dsh-inbox-bridge",
  "version": "2.11.2",
  "displayName": "GitHub inbox",
  "description": "GitHub inbox for DeepSeek Harness: reads one identity's view of a repository (or a few) and keeps only the events that concern it (my failing PR, reviews requested of me, my issues, mentions, default-branch CI), queuing them at turn boundaries — polling only while a turn runs.",
  "type": "module",
  "license": "MIT",
  "author": "c3115644151",
  "homepage": "https://github.com/c3115644151/dsh-inbox-bridge#readme",
  "bugs": {
    "url": "https://github.com/c3115644151/dsh-inbox-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3115644151/dsh-inbox-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "inbox",
    "ci"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "icon.svg",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test index.test.mjs scripts/github-inbox.test.mjs scripts/inbox-bridge.test.mjs",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "market:release": "node scripts/build-market-index.mjs --check --release"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
