{
  "name": "dsh-inbox-bridge",
  "version": "2.0.3",
  "displayName": "GitHub inbox",
  "description": "GitHub inbox for DeepSeek Harness: reads CI runs, pull requests and issues on an interval, queues one notice for the next turn, and can wake one idle session.",
  "type": "module",
  "license": "MIT",
  "author": "c3115644151",
  "homepage": "https://github.com/c3115644151/dsh-inbox-bridge#readme",
  "bugs": {
    "url": "https://github.com/c3115644151/dsh-inbox-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3115644151/dsh-inbox-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "inbox",
    "ci"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "icon.svg",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test index.test.mjs scripts/github-inbox.test.mjs scripts/inbox-bridge.test.mjs",
    "market": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "market:release": "node scripts/build-market-index.mjs --check --release"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
